# ANTHROPIC_API_KEY: clave de la API de Claude (Anthropic). Opción principal.
# Consíguela en https://console.anthropic.com → API Keys (requiere crédito).
# En Netlify se configura en: Site configuration → Environment variables.
ANTHROPIC_API_KEY="TU_CLAVE_DE_ANTHROPIC"

# GEMINI_API_KEY: alternativa GRATUITA (Google Gemini, sin tarjeta).
# Consíguela en https://aistudio.google.com/apikey → Create API key.
# Solo se usa si ANTHROPIC_API_KEY no está configurada.
GEMINI_API_KEY="TU_CLAVE_DE_GEMINI_OPCIONAL"
